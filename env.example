# ─────────────────────────────────────────────────
# KasiScore — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────
# API-Football key (get free key at api-football.com)
AFOOT_API_KEY=your_api_football_key_here

# ── OPTIONAL: Odds fallback ───────────────────────
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_API_TIMEOUT=5
ODDS_API_REGIONS=eu
ODDS_API_MARKETS=h2h
ODDS_API_ENABLED=1

# ── SERVER ────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
TIMEZONE=Africa/Johannesburg
LOG_LEVEL=INFO

# ── AUTH ──────────────────────────────────────────
# Leave blank to auto-generate a random secret on each start
AUTH_SECRET=your_long_random_string_here
AUTH_ADMIN_KEY=change_me_to_something_secret


# ── NETLIFY DEPLOYMENT ────────────────────────────
# Set BACKENDURL in Netlify env vars (not in this file) to point to your
# deployed FastAPI server URL, e.g. https://kasiscore.onrender.com
# BACKENDURL is read by netlify/functions/api.js at runtime.

# ── EMAIL (password reset) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
PUBLIC_APP_URL=https://your-netlify-site.netlify.app

AUTH_SECRET=any_long_random_string
AUTH_ADMIN_KEY=another_secret_key
ADMIN_EMAIL=jbatuma@yahoo.com
PAYMENT_ADMIN_EMAIL=jbatuma@yahoo.com
PUBLIC_APP_URL=https://yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=
SMTP_TLS=1

# ── PAYMENTS ─────────────────────────────────────
PAYFAST_PASSPHRASE=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ADMIN_EMAIL=

# ── PUSH NOTIFICATIONS ───────────────────────────
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@kasiscore.com

# ── MISC ─────────────────────────────────────────
RESET_DEV_MODE=0
RATE_LIMIT_PER_MINUTE=30

# v182 multi-sport providers
# Football (API-Football / API-Sports)
AFOOT_API_KEY=
# Rugby (API-Sports Rugby)
RUGBY_API_KEY=
# Optional cricket/other market odds enrichment
ODDS_API_KEY=
